## ---- LLM ----
LLM_PROVIDER=ollama
# Provider-agnostic chat model override (the provider's own *_CHAT_MODEL wins).
# CHAT_MODEL=
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3:latest
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_TIMEOUT=120

# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# Default gpt-4o-mini (gpt-5.3-codex for LLM_PROVIDER=openai-codex).
# OPENAI_CHAT_MODEL=gpt-4o-mini
# OPENAI_TIMEOUT=120
# OPENAI_EMBED_MODEL=text-embedding-3-small
# Auto: "responses" when the model name contains "codex", else chat_completions.
# OPENAI_API_MODE=
# OPENAI_REASONING_EFFORT=medium
# Sampling temperature for chat_completions (default 0.2; also used by the
# digitalocean and opencode providers). Use "none" to omit
# the field entirely — reasoning models reject any non-default temperature.
# OPENAI_TEMPERATURE=0.2

# DigitalOcean Serverless Inference (OpenAI-compatible; alias provider "do")
# LLM_PROVIDER=digitalocean
# DIGITALOCEAN_API_KEY=do_inference_...
# DIGITALOCEAN_BASE_URL=https://inference.do-ai.run/v1
# DIGITALOCEAN_CHAT_MODEL=meta-llama/Llama-3.3-70B-Instruct
# DIGITALOCEAN_EMBED_MODEL=qwen3-embedding-0.6b
# DIGITALOCEAN_TIMEOUT=120

# opencode Zen relay (OpenAI-compatible; aliases "opencode-go", and
# "opencode-zen"/"zen" for the credit-funded tier). One key from
# https://opencode.ai/auth works on both tiers; the provider alias picks the
# default base URL and model.
# LLM_PROVIDER=opencode
# Also read from OPENCODE_GO_API_KEY / OPENCODE_ZEN_API_KEY (in that order), so
# one .env can feed other opencode-aware tools unchanged.
# OPENCODE_API_KEY=sk-...
# OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1
# Default kimi-k2.7-code (claude-sonnet-5 on the zen tier).
# OPENCODE_CHAT_MODEL=kimi-k2.7-code
# OPENCODE_TIMEOUT=120
# The relay demands an x-opencode-session header on every request; a random id
# is minted per process. Pin it only to share one prompt-cache lane.
# OPENCODE_SESSION_ID=
#
# The relay serves no /embeddings endpoint, so vector memory needs a different
# backend. Unset, it falls back to Ollama (OLLAMA_URL + OLLAMA_EMBED_MODEL).
# EMBED_PROVIDER=openai

## ---- Agent ----
AGENT_MAX_STEPS=25
AGENT_CONTEXT_TAIL=30
AGENT_MEMORY_HITS=5
AGENT_DEDUP_DISTANCE=0.08
AGENT_VECTOR_COLLECTION=memories

# Storage paths (defaults shown). docker-compose.yml pins DATA_DIR, SKILLS_DIR
# and SCHEDULER_DB to /app/data/..., so these matter for local (non-Docker)
# runs — e.g. DATA_DIR=$PWD/data for `go run ./cmd/gateway` or the omega CLI.
# DATA_DIR=/app/data
# AGENT_DB=${DATA_DIR}/agent_memory.sqlite3
# AGENT_VECTOR_DIR=${DATA_DIR}/chromem
# SKILLS_DIR=${DATA_DIR}/skills
# SCHEDULER_DB=${DATA_DIR}/scheduler.sqlite3

# Let the model batch independent tool calls into one {"type":"tool_calls"}
# envelope, executed concurrently. AGENT_MAX_PARALLEL caps both the concurrency
# and the number of calls accepted per batch.
AGENT_PARALLEL_TOOLS=false
AGENT_MAX_PARALLEL=4

# Auto-memory extraction: after each final answer, a background LLM pass
# distils the turn into durable facts and stores them in vector memory
# (tagged source=auto-extract). Existing SHA256 + cosine dedup applies.
# At most 2 extraction passes run at once; extra passes are dropped.
AUTO_MEMORY_EXTRACT=false
AUTO_MEMORY_MAX_FACTS=5
AUTO_MEMORY_MIN_ANSWER_LEN=80

## ---- Skills ----
SKILL_HTTP_TIMEOUT=30
SKILL_SHELL_ENABLED=false
SKILL_SSH_ENABLED=false
# Default SSH user is root.
# SKILL_SSH_DEFAULT_USER=root
# SKILL_SSH_IDENTITY_FILE=/app/data/id_rsa
# SKILL_SSH_PRIVATE_KEY=
#
# Outbound skills always refuse link-local / cloud-metadata (169.254.0.0/16,
# fe80::/10, fd00:ec2::254), unspecified and multicast addresses. Set to false
# to also block loopback, RFC1918, ULA and CGNAT (not enforced on the final
# target when an HTTP(S) proxy env var is in use).
# SKILL_ALLOW_PRIVATE_NETWORKS=true

## ---- Skill playground & audit ----
# The playground (POST /api/skills/{name}/invoke, the ▶ button in the web UI)
# and audit replay run skills outside the agent loop. Set to true to disable
# both — worth considering if the gateway is reachable by anyone you do not
# trust (and set GATEWAY_API_TOKEN below in that case).
PLAYGROUND_DISABLED=false

# Max bytes of args/result JSON stored per audit row; 0 disables the audit log.
AUDIT_MAX_BLOB_BYTES=65536

## ---- Scheduler ----
# How often the runner wakes to evaluate cron expressions. Cron matches whole
# minutes, so values above 60 mean missed minutes are swept on the next tick
# (bounded to 60 minutes of catch-up), and each task still runs once.
SCHEDULER_TICK_SEC=60

## ---- MCP (Model Context Protocol) ----
# The gateway exposes its skills as MCP tools at POST /mcp (enabled by default).
# Set MCP_SERVER_DISABLED=true to turn the endpoint off.
# MCP_SERVER_DISABLED=false
#
# Consume tools from remote MCP servers (comma-separated "name=url" entries).
# Tools are registered locally as "<name>_<tool>". Append "|Header: Value" to
# add one request header (e.g. an auth token).
# MCP_SERVERS=weather=https://example.com/mcp,docs=https://docs.host/mcp|Authorization: Bearer TOKEN

## ---- Telegram bot ----
TELEGRAM_BOT_TOKEN=
# Auth is on by default (fail-closed): the bot refuses to start without
# BOT_ADMIN_ID unless BOT_AUTH_ENABLED=false is set explicitly. Users are
# authorized by their own Telegram user ID (a group chat ID does not count).
BOT_AUTH_ENABLED=true
BOT_ADMIN_ID=0
# BOT_AUTH_DB=/app/data/telegram_auth.sqlite3
# Gateway base URL for the bot (compose sets http://gateway:8000).
# GATEWAY_URL=http://127.0.0.1:8000

## ---- Network ----
BACKEND_PORT=8000
# Host port for the nginx UI (Docker Compose only).
# FRONTEND_PORT=80
# Compose network MTU; set to your VPN tunnel MTU (e.g. 1420 for WireGuard).
# DOCKER_NETWORK_MTU=1500

## ---- API access control ----
# When set, /api/* and /mcp require "Authorization: Bearer <token>" (/health
# stays open). The Telegram bot and `omega` remote mode send it automatically;
# the web UI asks for it on the first 401 and keeps it in localStorage.
# Set it whenever the gateway is reachable beyond loopback.
# GATEWAY_API_TOKEN=
#
# Cross-origin callers allowed to use the API (comma-separated, "*" = any).
# Empty = same-origin only, which is all the bundled UI needs. State-changing
# requests with a foreign Origin header are rejected with 403.
# CORS_ALLOWED_ORIGINS=

## ---- omega CLI ----
# Base URL of a running gateway; switches the CLI from local to remote mode.
# OMEGA_REMOTE=http://localhost:8000

## ---- Docker bind-mount permissions ----
# Containers run as this UID:GID so ./data files are owned by the host user.
# `make` targets export these automatically from `id -u` / `id -g`.
# Set here only if running docker compose directly without make.
# UID=1000
# GID=1000
