# Editors / IDEs
.idea/
.vscode/
*.swp
*~

# OS junk
.DS_Store
Thumbs.db

# Build output (all binaries land in ./bin via the Makefile: gateway, telegram-bot, migrate-vector, omega)
build/
/bin/
# `go build ./cmd/<name>` without -o drops the binary in the repo root
/gateway
/telegram-bot
/migrate-vector
/cli
/omega
/mockllm

# Go test / coverage artifacts
*.test
!Dockerfile.test
*.out
coverage.*
*.prof

# Runtime state: SQLite DBs, chromem-go vector store, dynamic markdown skills
data/

# Secrets / local env (.env.example stays tracked)
.env
.env.*
!.env.example

# Frontend build artifacts (web/node_modules and web/dist are covered by web/.gitignore)
*.tsbuildinfo

# Local Claude Code / editor-tool config (per-machine)
.claude/launch.json
.claude/settings.local.json
